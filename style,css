body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.7;
    color: #222;
    background: #f7f7f7;
}

.container {
    max-width: 900px;
    margin: auto;
    padding: 40px 25px;
}

header {
    background: #222;
    color: white;
    padding: 60px 25px;
}

header h1 {
    margin: 0;
    font-size: 42px;
}

header p {
    font-size: 20px;
    margin-top: 10px;
}

section {
    background: white;
    margin-top: 25px;
    padding: 30px;
    border-radius: 6px;
}

h2 {
    margin-top: 0;
    color: #333;
}

h3 {
    margin-bottom: 5px;
}

a {
    color: #333;
}

footer {
    text-align: center;
    padding: 30px;
    color: #666;
}
